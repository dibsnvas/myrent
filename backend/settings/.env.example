# Copy to settings/.env for local development. On Render, set the same names as environment variables.
MYRENT_ENV_ID=local
MYRENT_SECRET_KEY=change-me
MYRENT_ALLOWED_HOSTS=localhost,127.0.0.1
MYRENT_CORS_ALLOWED_ORIGINS=http://localhost:5173
MYRENT_FRONTEND_URL=http://localhost:5173
MYRENT_CRON_SECRET=local-cron-secret

# --- Production only (MYRENT_ENV_ID=prod) ---
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4; Render has no IPv6).
MYRENT_DB_NAME=postgres
MYRENT_DB_USER=postgres.your-project-ref
MYRENT_DB_PASSWORD=
MYRENT_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
MYRENT_DB_PORT=5432
MYRENT_DB_SSLMODE=require

# Uploads: local | database | s3. For s3 (e.g. Supabase -> Storage -> PRIVATE bucket "documents",
# Storage -> S3 Connection -> new access key) fill the MYRENT_S3_* values below.
MYRENT_FILE_STORAGE=local
MYRENT_S3_BUCKET=documents
MYRENT_S3_ENDPOINT_URL=https://your-project-ref.storage.supabase.co/storage/v1/s3
MYRENT_S3_REGION=eu-central-1
MYRENT_S3_ACCESS_KEY_ID=
MYRENT_S3_SECRET_ACCESS_KEY=

# Optional: reminder emails via resend.com (leave empty to print emails to the log instead).
MYRENT_RESEND_API_KEY=
MYRENT_EMAIL_FROM=MyRent <onboarding@resend.dev>
